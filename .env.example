# CCE-M5 - Variables de entorno (copiar a .env y ajustar)

# ------------------------------------------------------------------
# Rutas del proyecto
# ------------------------------------------------------------------
CCE_PROJECT_DIR=/home/apolo/proyectos/CCE-M5-Web-Presentaciones

# ------------------------------------------------------------------
# Web estática / Astro
# ------------------------------------------------------------------
CCE_BASE_PATH=/
CCE_SITE_URL=http://localhost:4321
CCE_WEB_HOST=0.0.0.0
CCE_WEB_PORT=4321

# ------------------------------------------------------------------
# Admin API
# ------------------------------------------------------------------
CCE_ADMIN_HOST=0.0.0.0
CCE_ADMIN_PORT=4323
CCE_ADMIN_JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-de-minimo-32-bytes
CCE_ADMIN_TOKEN_TTL=480
CCE_ADMIN_DEFAULT_USER=rafael.torres
CCE_ADMIN_DEFAULT_PASSWORD=1234
CCE_ADMIN_DEFAULT_NAME=Rafael Torres
ADMIN_CORS_ORIGINS=http://localhost:4321,http://localhost:4323,http://192.168.68.240:4321,http://192.168.68.240:4323

# ------------------------------------------------------------------
# Editores (legacy, ahora integrados en la Admin API)
# ------------------------------------------------------------------
EDITOR_HOST=0.0.0.0
EDITOR_PORT=4324
EDITOR_ACORDES_HOST=0.0.0.0
EDITOR_ACORDES_PORT=4322

# ------------------------------------------------------------------
# GitHub proxy de comentarios
# ------------------------------------------------------------------
GITHUB_TOKEN_CC5M5=
CCE_GITHUB_COMENTARIOS_OWNER=cce-m5
CCE_GITHUB_COMENTARIOS_REPO=cce-m5-music

# ------------------------------------------------------------------
# Rate limiting (opcional)
# ------------------------------------------------------------------
CCE_ADMIN_RATE_LIMIT_MAX_ATTEMPTS=5
CCE_ADMIN_RATE_LIMIT_WINDOW_SECONDS=300
CCE_ADMIN_RATE_LIMIT_BLOCK_SECONDS=900
# CCE_ADMIN_REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------
# Node / build
# ------------------------------------------------------------------
CCE_NODE_BIN=/usr/bin

# ------------------------------------------------------------------
# Backup
# ------------------------------------------------------------------
CCE_BACKUP_KEEP_DAYS=30
