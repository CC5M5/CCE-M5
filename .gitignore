# Entornos
.env
.env.local
.env.*.backup.*
.venv/
venv/

# Git
.git/
.gitignore

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node / web
node_modules/
web/node_modules/
web/dist/
!web/dist
!web/package.json
!web/astro.config.mjs
!web/tailwind.config.mjs
!web/tsconfig.json
!web/public/.gitkeep

# Datos de runtime (binarios, generados, backups). Se montan como volúmenes.
data/db.sqlite3
data/db.sqlite3-shm
data/db.sqlite3-wal
data/db.sqlite3.backup.*
data/*.snapshot.*
data/seeds/*.backup
presentaciones_html/*
!presentaciones_html/.gitkeep
!presentaciones_html/README.md
presentaciones/
backups/*
!backups/.gitkeep
assets/*
!assets/.gitkeep
borradores/*
!borradores/.gitkeep

# Copias generadas durante el build
web/public/presentaciones_html/
web/public/fano_preview.png
web/public/presentaciones/
web/public/data/

# PNGs fallback generados de SVGs
data/ilustraciones/*.png

# Logs
*.log
logs/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# LFS / lockfiles grandes no necesarios en build
*.lock
!requirements.lock.txt
!web/package-lock.json
