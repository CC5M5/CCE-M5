---
import Layout from '@layouts/Layout.astro';
import '../styles/global.css';

const base = import.meta.env.BASE_PATH || '/';
---

<Layout title="Página no encontrada" description="La página que buscas no existe.">
  <section class="container mx-auto px-4 py-20 text-center">
    <h1 class="text-6xl font-heading font-extrabold text-liturgia-verde mb-4">404</h1>
    <p class="text-xl text-slate-700 mb-8">La página que buscas no existe o ha sido movida.</p>
    <a href={`${base}`} class="btn-primary">Volver al inicio</a>
  </section>
</Layout>
