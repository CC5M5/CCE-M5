---
import Layout from '@layouts/Layout.astro';
import { getCancionBySlug, getAllCancionesSlugs } from '@lib/db.js';
import { slugify } from '@lib/slug.js';
import VisorAcordes from '@components/VisorAcordes.astro';
import { Printer, Share2, Music } from 'lucide-react';
import '../../styles/global.css';

export async function getStaticPaths() {
  const slugs = getAllCancionesSlugs();
  return slugs.map(({ id, slug }) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const base = import.meta.env.BASE_PATH || '/';
const cancion = getCancionBySlug(slug);

if (!cancion) {
  return Astro.redirect(`${base}404`);
}

const cancionSlug = slugify(cancion.titulo);
const momentos = cancion.momentos || (cancion.momento_liturgico ? [cancion.momento_liturgico] : []);
const momentosTexto = momentos.join(', ') || 'varios';
---

<Layout 
  title={cancion.titulo} 
  description={`Letra y acordes de "${cancion.titulo}". Momentos: ${momentosTexto}. Tono: ${cancion.tono || '-'}.`}
  canonical={`cancionero/${cancionSlug}/`}
>
  <section class="container mx-auto px-4 py-10">
    <div class="max-w-3xl mx-auto">
      <nav aria-label="Migas de pan" class="text-sm text-slate-500 mb-4">
        <a href={`${base}`} class="hover:text-liturgia-verde">Inicio</a>
        <span class="mx-2">/</span>
        <a href={`${base}cancionero/`} class="hover:text-liturgia-verde">Cancionero</a>
        <span class="mx-2">/</span>
        <span class="text-slate-800" aria-current="page">{cancion.titulo}</span>
      </nav>

      <div class="flex items-start gap-3 mb-2">
        <Music class="w-8 h-8 text-liturgia-verde mt-1" />
        <h1 class="section-title mb-0">{cancion.titulo}</h1>
      </div>
      <hr class="border-slate-200 mb-6" />

      <div class="flex flex-wrap gap-4 mb-6 text-sm">
        {momentos.length > 0 ? (
          <div class="flex flex-wrap items-center gap-2">
            <span class="text-slate-500">Momentos:</span>
            {momentos.map(m => (
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-liturgia-verde/10 text-liturgia-verde">
                {m}
              </span>
            ))}
          </div>
        ) : (
          <div>
            <span class="text-slate-500">Momento:</span>{' '}
            <span class="font-medium">{cancion.momento_liturgico || 'Sin asignar'}</span>
          </div>
        )}
      </div>

      <VisorAcordes
        htmlVisual={cancion.html_visual || ''} 
        titulo={cancion.titulo}
        slug={cancionSlug}
        tono={cancion.tono || undefined}
        enlaceAudio={cancion.enlace_audio || undefined}
      />

      <div class="mt-8 flex flex-wrap gap-3 no-print">
        <button type="button" onclick="window.print()" class="btn-secondary">
          <Printer class="w-4 h-4" /> Imprimir
        </button>
        <button 
          type="button" 
          class="btn-secondary" 
          data-share
          data-title={cancion.titulo}
          data-url={`${base}cancionero/${cancionSlug}/`}
        >
          <Share2 class="w-4 h-4" /> Compartir
        </button>
      </div>
    </div>
  </section>

  <script define:vars={{ base }}>
    document.querySelectorAll('[data-share]').forEach(btn => {
      btn.addEventListener('click', async () => {
        const url = new URL(btn.dataset.url || '', window.location.origin).toString();
        const title = btn.dataset.title || document.title;
        if (navigator.share) {
          try { await navigator.share({ title, url }); } catch {}
        } else if (navigator.clipboard) {
          await navigator.clipboard.writeText(url);
          const original = btn.textContent;
          btn.textContent = '¡Copiado!';
          setTimeout(() => btn.textContent = original, 1500);
        }
      });
    });
  </script>

  <style>
    @media print {
      .no-print { display: none !important; }
      header, footer { display: none !important; }
    }
  </style>
</Layout>
