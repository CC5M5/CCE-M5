---
import { getAllPresentacionesFechas } from '@lib/db.js';
import { statSync } from 'node:fs';
import { join } from 'node:path';

export async function getStaticPaths() {
  const fechas = getAllPresentacionesFechas();
  if (fechas.length === 0) return [];
  return fechas.map(fecha => ({ params: { fecha } }));
}

const { fecha } = Astro.params;
const base = import.meta.env.BASE_PATH || "/";

// Timestamp de modificación del HTML embebido para evitar caché del navegador
let cacheBust = Date.now();
try {
  const htmlPath = join(process.cwd(), 'public', 'presentaciones_html', `${fecha}_presentacion`, 'index.html');
  cacheBust = Math.floor(statSync(htmlPath).mtimeMs);
} catch {
  // Si no existe el archivo, usamos Date.now()
}
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Presentación {fecha}</title>
    <style>
      html, body { margin: 0; padding: 0; height: 100%; overflow: hidden; background: #111; }
      iframe { width: 100%; height: 100%; border: none; }
    </style>
  </head>
  <body>
    <iframe src={`${base}presentaciones_html/${fecha}_presentacion/index.html?v=${cacheBust}`} title={`Presentación ${fecha}`} allowfullscreen></iframe>
  </body>
</html>
