---
import { getAllPresentacionesFechas } from '@lib/db.js';

export async function getStaticPaths() {
  const fechas = getAllPresentacionesFechas();
  if (fechas.length === 0) return [];
  return fechas.map(fecha => ({ params: { fecha } }));
}

const { fecha } = Astro.params;
const base = import.meta.env.BASE_PATH || "/";
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Presentación {fecha}</title>
    <style>
      html, body { margin: 0; padding: 0; height: 100%; overflow: hidden; background: #111; }
      iframe { width: 100%; height: 100%; border: none; }
    </style>
  </head>
  <body>
    <iframe src={`${base}presentaciones_html/${fecha}_presentacion/index.html`} title={`Presentación ${fecha}`} allowfullscreen></iframe>
  </body>
</html>
