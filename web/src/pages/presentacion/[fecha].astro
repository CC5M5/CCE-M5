---
export function getStaticPaths() {
  return [
    { params: { fecha: "2026-09-13" } },
    { params: { fecha: "2026-09-20" } },
  ];
}

const { fecha } = Astro.params;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Presentación {fecha}</title>
    <style>
      html, body { margin: 0; padding: 0; height: 100%; overflow: hidden; background: #111; }
      iframe { width: 100%; height: 100%; border: none; }
    </style>
  </head>
  <body>
    <iframe src={`/presentaciones_html/${fecha}_presentacion/index.html`} title={`Presentación ${fecha}`} allowfullscreen></iframe>
  </body>
</html>
